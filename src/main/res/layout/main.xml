<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/parentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <Button
                android:id="@+id/device_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="info" />

            <Button
                android:id="@+id/get_alias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="getAlias" />

            <EditText
                android:id="@+id/etxt_set_alias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:inputType="textEmailAddress" />

            <Button
                android:id="@+id/btn_set_alias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:text="Set alias" />


            <Button
                android:id="@+id/second_activity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2nd activity" />

            <Button
                android:id="@+id/geo_fencing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Geo" />

            <Button
                android:id="@+id/stop_geo_fencing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stop Geo" />

            <Switch
                android:id="@+id/push_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Push enabled" />

            <Button
                android:id="@+id/buttonDeviceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Get Device Info" />

            <Button
                android:id="@+id/dmcCallInApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FullScreen: App Open" />


            <Button
                android:id="@+id/inappModalType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modal: App Feedback" />

            <Button
                android:id="@+id/inappBannerType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Banner: App Discount" />

            <Button
                android:id="@+id/inappAppPromo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROMO: App Promo" />


            <Button
                android:id="@+id/multipleMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fetch Multiple Messages" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:text="This is a sample App"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/dummyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:text=""
                android:textColor="@android:color/black" />


            <Button
                android:id="@+id/inappInbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fetch Inbox Messages" />


            <Button
                android:id="@+id/btn_get_tags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get tags" />


            <EditText
                android:id="@+id/etxt_set_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Some text"
                android:inputType="text" />


            <Button
                android:id="@+id/btn_set_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="set tag" />

            <EditText
                android:id="@+id/etxt_remove_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Some text"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_remove_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Remove tag" />


            <EditText
                android:id="@+id/etxt_set_attribute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Some text"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_set_attribute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Set attribute" />

            <EditText
                android:id="@+id/etxt_get_attribute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Some text"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_get_attribute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Get attribute" />

            <EditText
                android:id="@+id/etxt_remove_attribute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Some text"
                android:inputType="text" />

            <Button
                android:id="@+id/btn_remove_attribute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Remove attribute" />


            <Button
                android:id="@+id/btn_remove_badge_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Remove badge number" />


            <Button
                android:id="@+id/btn_orientation"
                android:text="Select screen orientation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>


    </LinearLayout>

</ScrollView>